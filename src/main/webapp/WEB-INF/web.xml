<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Ocean View Resort Room Reservation System</display-name>
    <description>
        Java EE web application for managing room reservations at Ocean View Resort.
        CIS6003 Advanced Programming – Cardiff Metropolitan University.
    </description>

    <!-- ═══════ Context Parameters ═══════ -->
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:mysql://localhost:3306/ocean_view_resort?useSSL=false&amp;serverTimezone=Asia/Colombo&amp;allowPublicKeyRetrieval=true</param-value>
    </context-param>
    <context-param>
        <param-name>db.username</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>db.password</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>jwt.secret</param-name>
        <param-value>OceanViewResort256BitSecretKeyForJWTTokenGeneration2026</param-value>
    </context-param>
    <context-param>
        <param-name>jwt.expiration</param-name>
        <param-value>86400000</param-value>
    </context-param>

    <!-- ═══════ Application Lifecycle Listener ═══════ -->
    <listener>
        <listener-class>com.oceanview.resort.config.AppContextListener</listener-class>
    </listener>

    <!-- ═══════ Filters ═══════ -->

    <!-- Character Encoding Filter -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.oceanview.resort.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Filter (JWT / Session based) -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.oceanview.resort.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- CORS Filter -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.oceanview.resort.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- ═══════ Servlets: API Endpoints ═══════ -->

    <!-- Auth API -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Reservation API -->
    <servlet>
        <servlet-name>ReservationApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.ReservationApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReservationApiServlet</servlet-name>
        <url-pattern>/api/reservations/*</url-pattern>
    </servlet-mapping>

    <!-- Room API -->
    <servlet>
        <servlet-name>RoomApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.RoomApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomApiServlet</servlet-name>
        <url-pattern>/api/rooms/*</url-pattern>
    </servlet-mapping>

    <!-- Bill API -->
    <servlet>
        <servlet-name>BillApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.BillApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillApiServlet</servlet-name>
        <url-pattern>/api/bills/*</url-pattern>
    </servlet-mapping>

    <!-- Customer API -->
    <servlet>
        <servlet-name>CustomerApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.CustomerApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerApiServlet</servlet-name>
        <url-pattern>/api/customers/*</url-pattern>
    </servlet-mapping>

    <!-- Report API -->
    <servlet>
        <servlet-name>ReportApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.ReportApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportApiServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>

    <!-- Dashboard API -->
    <servlet>
        <servlet-name>DashboardApiServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.api.DashboardApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardApiServlet</servlet-name>
        <url-pattern>/api/dashboard/*</url-pattern>
    </servlet-mapping>

    <!-- ═══════ Servlets: Page (JSP) Routing ═══════ -->

    <servlet>
        <servlet-name>PageServlet</servlet-name>
        <servlet-class>com.oceanview.resort.servlet.PageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PageServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/dashboard</url-pattern>
        <url-pattern>/reservations</url-pattern>
        <url-pattern>/reservations/*</url-pattern>
        <url-pattern>/rooms</url-pattern>
        <url-pattern>/rooms/*</url-pattern>
        <url-pattern>/bills</url-pattern>
        <url-pattern>/bills/*</url-pattern>
        <url-pattern>/reports</url-pattern>
        <url-pattern>/reports/*</url-pattern>
        <url-pattern>/customers</url-pattern>
        <url-pattern>/customers/*</url-pattern>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!-- ═══════ Welcome File ═══════ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ═══════ Error Pages ═══════ -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error/500.jsp</location>
    </error-page>

    <!-- ═══════ Session Config ═══════ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>

